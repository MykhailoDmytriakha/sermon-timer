<?xml version="1.0" encoding="utf-8"?>
<!--
  The android:tag value MUST be "aod_chronometer" — Galaxy Watch sysui calls
  cardChronometerViewContainer.findViewWithTag("aod_chronometer") on the inflated
  RemoteViews and logs `Could not fetch the chronometer` when the tag is missing,
  falling back to the static cardContents string. Verified in
  WFOverlayNowBarCardView.setData via dexdump of SecClockworkSysUi.apk.
-->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nowbar_chronometer"
    android:tag="aod_chronometer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textColor="@android:color/white"
    android:textSize="20sp"
    android:textStyle="bold"
    android:gravity="center" />
