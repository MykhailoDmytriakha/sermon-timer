<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground.
  Visual: clean white stopwatch silhouette, mathematically centred at (54,54).
  Three colour pips at 12 / 4 / 8 (matching Intro/Main/Outro phase colours)
  serve as visual rhythm without making the icon noisy at small sizes.

  Geometry constants:
    centre  = (54, 54)
    R_ring  = 32  (visible ring centreline)
    R_pip   = 22  (colour pips)
    safe-zone radius = 33 (Android adaptive icon spec)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ===== Stopwatch top stem ===== -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,17 h8 v5 h-8 z" />

    <!-- ===== Outer ring — single solid circle, 4dp stroke, white ===== -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:fillColor="#00000000"
        android:pathData="M54,22 A32,32 0 1,1 53.999,22" />

    <!-- ===== Three colour pips inside the ring at 12 / 4 / 8 ===== -->
    <!-- 12 o'clock (Intro = green) -->
    <path
        android:fillColor="#66BB6A"
        android:pathData="M54,32 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0" />
    <!-- 4 o'clock (Main = blue): centre at (54+22*cos30°, 54+22*sin30°) = (73.05, 65) -->
    <path
        android:fillColor="#42A5F5"
        android:pathData="M73.05,65 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0" />
    <!-- 8 o'clock (Outro = orange): centre at (54-22*cos30°, 54+22*sin30°) = (34.95, 65) -->
    <path
        android:fillColor="#FFA726"
        android:pathData="M34.95,65 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0" />

    <!-- ===== Hour hand pointing up (12 o'clock direction) ===== -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M53,42 L55,42 L55.6,67 L52.4,67 Z" />

    <!-- ===== Centre cap ===== -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,67 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />
</vector>
