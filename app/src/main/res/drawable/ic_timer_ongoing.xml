<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon shown on the watch-face Ongoing Activity chip.
  Must be monochrome white (Wear/Android tints to the channel colour).
  Stylised stopwatch silhouette with three notch marks (intro/main/outro)
  matches the launcher icon's 3-segment ring concept.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/colorAccent">
    <!-- Top stem -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M10,1 h4 v2 h-4 z" />
    <!-- Outer ring (stroke) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,4 a9,9 0 1,1 -0.001,0 z M12,6 a7,7 0 1,0 0.001,0 z" />
    <!-- 12 o'clock notch -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M11.5,7 h1 v1.5 h-1 z" />
    <!-- 4 o'clock notch -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M16.4,12.7 l0.85,0.5 l-0.75,1.3 l-0.85,-0.5 z" />
    <!-- 8 o'clock notch -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M7.6,12.7 l-0.85,0.5 l0.75,1.3 l0.85,-0.5 z" />
    <!-- Hour hand pointing up -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M11.55,9.5 h0.9 l0.4,4.5 h-1.7 z" />
    <!-- Center cap -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,14 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0" />
</vector>
